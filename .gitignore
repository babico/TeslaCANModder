# Editors
.vscode/*
!.vscode/settings.json
.idea/
.cursor/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Node / web
web/node_modules/
web/dist/
web/coverage/
web/*.log
web/*.png
web/.vite/

# Legacy web app (removed from active workspace)
web/

# Client build artifacts
client/dist-ios/
client/dist-web/
client/.expo/
client/.expo-shared/
client/coverage/

# Auto-generated docs bundle (regenerated on every prestart/prebuild/pretest)
client/src/generated/

# Shared package build artifacts
packages/*/dist/
packages/*/coverage/
packages/*/*.tsbuildinfo

# Common build logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PlatformIO / firmware build
firmware/.pio/
firmware/.pio-home/
firmware/.cache/
firmware/build/

# Python
__pycache__/
*.pyc

# Generic temp
*.tmp
*.temp

.claude
.husky/
node_modules/
.venv
.kiro

# lock file
package-lock.json
