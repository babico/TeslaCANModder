{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://teslacanmodder.local/schemas/serial-output.schema.json",
	"title": "Serial Output Message",
	"description": "Union schema for JSON lines emitted by firmware/lib/io/serial/*",
	"schemaVersion": 2,
	"messageSections": {
		"boot": [
			"meta",
			"connectivity",
			"state",
			"driverAssist",
			"vehicle",
			"platform",
			"firmware",
			"battery",
			"safety",
			"can",
			"features"
		],
		"status": [
			"meta",
			"connectivity",
			"state",
			"driverAssist",
			"vehicle",
			"platform",
			"firmware",
			"battery",
			"safety",
			"can",
			"features"
		]
	},
	"messages": [
		{
			"type": "boot",
			"command": null,
			"schemaRef": "#/$defs/Boot",
			"sections": [
				"meta",
				"connectivity",
				"state",
				"driverAssist",
				"vehicle",
				"platform",
				"firmware",
				"battery",
				"safety",
				"can",
				"features"
			],
			"notes": "Emitted once when the serial transport becomes ready."
		},
		{
			"type": "status",
			"command": "status",
			"schemaRef": "#/$defs/Status",
			"sections": [
				"meta",
				"connectivity",
				"state",
				"driverAssist",
				"vehicle",
				"platform",
				"firmware",
				"battery",
				"safety",
				"can",
				"features"
			],
			"notes": "Full runtime snapshot used by the shared protocol parser and reducer."
		},
		{
			"type": "statusLive",
			"command": "status:live",
			"schemaRef": "#/$defs/StatusLive",
			"sections": [],
			"notes": "Reports whether high-rate status streaming is enabled."
		},
		{
			"type": "status_meta",
			"command": "status:meta",
			"schemaRef": "#/$defs/StatusMeta",
			"sections": ["meta"]
		},
		{
			"type": "status_features",
			"command": "status:features",
			"schemaRef": "#/$defs/StatusFeatures",
			"sections": ["features"]
		},
		{
			"type": "status_can",
			"command": "status:can",
			"schemaRef": "#/$defs/StatusCan",
			"sections": ["can"]
		},
		{
			"type": "status_state",
			"command": "status:state",
			"schemaRef": "#/$defs/StatusState",
			"sections": ["state"]
		},
		{
			"type": "status_compact",
			"command": "status:compact",
			"schemaRef": "#/$defs/StatusCompact",
			"sections": ["meta", "connectivity", "state", "features", "can", "stream"]
		},
		{
			"type": "platform",
			"command": "platform",
			"schemaRef": "#/$defs/Platform",
			"sections": ["platform", "canHealth"]
		},
		{
			"type": "vehicle",
			"command": "vehicle",
			"schemaRef": "#/$defs/Vehicle",
			"sections": ["vehicle"]
		},
		{
			"type": "fwcompat",
			"command": "fwcompat",
			"schemaRef": "#/$defs/FwCompat",
			"sections": ["firmware"]
		},
		{
			"type": "powertrain",
			"command": "powertrain",
			"schemaRef": "#/$defs/Powertrain",
			"sections": ["vehicle"]
		},
		{
			"type": "tpms",
			"command": "tpms",
			"schemaRef": "#/$defs/Tpms",
			"sections": ["vehicle"]
		},
		{
			"type": "bms",
			"command": "bms",
			"schemaRef": "#/$defs/Bms",
			"sections": ["battery"]
		}
	],
	"features": [
		{
			"id": "airRecirc",
			"title": "Air Recirculation",
			"kind": "command"
		},
		{
			"id": "banShield",
			"title": "Ban Shield",
			"kind": "command"
		},
		{
			"id": "bmsTelemetry",
			"title": "BMS Telemetry",
			"kind": "query",
			"commands": ["bms"],
			"outputTags": ["bms"],
			"statePaths": ["battery"]
		},
		{
			"id": "canClock",
			"title": "CAN Clock",
			"kind": "command",
			"commands": ["canclock:auto", "canclock:8", "canclock:12", "canclock:16", "canclock:20", "status:can"],
			"outputTags": ["status", "status_can", "status_compact"],
			"statePaths": ["can.clock", "can.health"]
		},
		{
			"id": "rawCan",
			"title": "Raw CAN Stream",
			"kind": "command",
			"commands": ["can:raw:on", "can:raw:off"],
			"outputTags": ["status", "status_compact", "frame"],
			"statePaths": ["state.rawCan"]
		},
		{
			"id": "canSimulation",
			"title": "CAN Simulation",
			"kind": "command"
		},
		{
			"id": "chargeControl",
			"title": "Charge Control",
			"kind": "command"
		},
		{
			"id": "climate",
			"title": "Climate",
			"kind": "command"
		},
		{
			"id": "displayBrightness",
			"title": "Display Brightness",
			"kind": "command"
		},
		{
			"id": "driveContext",
			"title": "Drive Context",
			"kind": "internal"
		},
		{
			"id": "driveMode",
			"title": "Drive Mode Override",
			"kind": "command"
		},
		{
			"id": "fsd",
			"title": "FSD",
			"kind": "command",
			"commands": ["fsd:on", "fsd:off", "fsd:force:on", "fsd:force:off"],
			"outputTags": ["boot", "status", "status_state", "status_compact"],
			"statePaths": ["state.fsd", "state.fsdForce"]
		},
		{
			"id": "fwCompat",
			"title": "Firmware Compatibility",
			"kind": "query",
			"commands": ["fwcompat"],
			"outputTags": ["fwcompat"],
			"statePaths": ["firmware"]
		},
		{
			"id": "isaChime",
			"title": "ISA Chime",
			"kind": "command"
		},
		{
			"id": "lights",
			"title": "Lighting",
			"kind": "command"
		},
		{
			"id": "lockControl",
			"title": "Lock and Horn",
			"kind": "command"
		},
		{
			"id": "mirrorControl",
			"title": "Mirrors",
			"kind": "command"
		},
		{
			"id": "mqttBridge",
			"title": "MQTT Bridge",
			"kind": "command",
			"commands": ["mqtt:on", "mqtt:off", "mqtt:broker:<host>", "mqtt:port:1883", "mqtt:interval:1000"],
			"outputTags": ["boot", "status"],
			"statePaths": ["firmware.mqtt", "firmware.mqttConnected"]
		},
		{
			"id": "nagControl",
			"title": "Nag Control",
			"kind": "command",
			"commands": ["nag:on", "nag:off", "status:state"],
			"outputTags": ["boot", "status", "status_state", "status_compact"],
			"statePaths": ["state.nag", "state.nagKiller"]
		},
		{
			"id": "speedOffset",
			"title": "Speed Offset",
			"kind": "command",
			"commands": ["offset:0", "offset:auto", "offset:off", "status:state"],
			"outputTags": ["boot", "status", "status_state", "status_compact"],
			"statePaths": ["state.offset"]
		},
		{
			"id": "pedalMode",
			"title": "Pedal Mode",
			"kind": "command"
		},
		{
			"id": "powerState",
			"title": "Power State",
			"kind": "command"
		},
		{
			"id": "powertrainTelemetry",
			"title": "Powertrain Telemetry",
			"kind": "query",
			"commands": ["powertrain"],
			"outputTags": ["powertrain"],
			"statePaths": ["vehicle"]
		},
		{
			"id": "precondition",
			"title": "Precondition",
			"kind": "command",
			"commands": ["precondition:on", "precondition:off", "status:state"],
			"outputTags": ["boot", "status", "status_state", "status_compact"],
			"statePaths": ["state.precondition"]
		},
		{
			"id": "speedProfile",
			"title": "Speed Profile",
			"kind": "command",
			"commands": ["profile:0", "profile:1", "profile:2", "profile:3", "profile:4", "profile:auto", "profile:lock", "profile:unlock", "status:state"],
			"outputTags": ["boot", "status", "status_state", "status_compact"],
			"statePaths": ["state.profile"]
		},
		{
			"id": "regenMode",
			"title": "Regeneration Mode",
			"kind": "command"
		},
		{
			"id": "regionCodec",
			"title": "Region Codec",
			"kind": "internal"
		},
		{
			"id": "seatHeating",
			"title": "Seat Heating",
			"kind": "command"
		},
		{
			"id": "seatbeltEmulation",
			"title": "Rear Seatbelt Emulation",
			"kind": "command"
		},
		{
			"id": "sentry",
			"title": "Sentry Mode",
			"kind": "command"
		},
		{
			"id": "singleShotTx",
			"title": "Single-shot TX",
			"kind": "command"
		},
		{
			"id": "stopMode",
			"title": "Stop Mode",
			"kind": "command"
		},
		{
			"id": "stream",
			"title": "Stream",
			"kind": "command",
			"commands": ["stream:on", "stream:off", "status:live:on", "status:live:off", "status:live", "status:compact"],
			"outputTags": ["status", "statusLive", "status_compact", "frame"],
			"statePaths": ["state.stream"]
		},
		{
			"id": "summon",
			"title": "Summon",
			"kind": "command"
		},
		{
			"id": "tlsscRestore",
			"title": "TLSSC Restore",
			"kind": "command"
		},
		{
			"id": "tpmsTelemetry",
			"title": "TPMS",
			"kind": "query",
			"commands": ["tpms"],
			"outputTags": ["tpms"],
			"statePaths": ["vehicle"]
		},
		{
			"id": "trackMode",
			"title": "Track Mode",
			"kind": "command",
			"commands": ["trackmode:on", "trackmode:off", "status:state"],
			"outputTags": ["boot", "status", "status_state", "status_compact"],
			"statePaths": ["state.trackMode"]
		},
		{
			"id": "trunkFrunk",
			"title": "Trunk and Frunk",
			"kind": "command"
		},
		{
			"id": "turnSignal",
			"title": "Turn Signals",
			"kind": "command"
		},
		{
			"id": "variant",
			"title": "Variant",
			"kind": "command"
		},
		{
			"id": "vehicleConfig",
			"title": "Vehicle Config",
			"kind": "query",
			"commands": ["vehicle", "platform", "status:meta"],
			"outputTags": ["vehicle", "platform", "status_meta"],
			"statePaths": ["vehicle", "platform", "meta"]
		},
		{
			"id": "windowVent",
			"title": "Window Vent",
			"kind": "command"
		},
		{
			"id": "wiper",
			"title": "Wiper",
			"kind": "command"
		}
	],
	"oneOf": [
		{ "$ref": "#/$defs/Ack" },
		{ "$ref": "#/$defs/Error" },
		{ "$ref": "#/$defs/LogSimple" },
		{ "$ref": "#/$defs/LogDump" },
		{ "$ref": "#/$defs/Frame" },
		{ "$ref": "#/$defs/Pong" },
		{ "$ref": "#/$defs/StatusLive" },
		{ "$ref": "#/$defs/Bms" },
		{ "$ref": "#/$defs/Tpms" },
		{ "$ref": "#/$defs/Powertrain" },
		{ "$ref": "#/$defs/FwCompat" },
		{ "$ref": "#/$defs/Vehicle" },
		{ "$ref": "#/$defs/Platform" },
		{ "$ref": "#/$defs/Boot" },
		{ "$ref": "#/$defs/Status" },
		{ "$ref": "#/$defs/StatusMeta" },
		{ "$ref": "#/$defs/StatusFeatures" },
		{ "$ref": "#/$defs/StatusCan" },
		{ "$ref": "#/$defs/StatusState" },
		{ "$ref": "#/$defs/StatusCompact" }
	],
	"$defs": {
		"Bool01": {
			"type": "integer",
			"enum": [0, 1]
		},
		"TypeTag": {
			"type": "object",
			"properties": {
				"t": { "type": "string" }
			},
			"required": ["t"]
		},
		"CanHealthEntry": {
			"type": "object",
			"properties": {
				"on": { "$ref": "#/$defs/Bool01" },
				"det": { "$ref": "#/$defs/Bool01" }
			},
			"required": ["on", "det"],
			"additionalProperties": false
		},
		"CanHealth": {
			"type": "object",
			"properties": {
				"chassis": { "$ref": "#/$defs/CanHealthEntry" },
				"vehicle": { "$ref": "#/$defs/CanHealthEntry" },
				"body": { "$ref": "#/$defs/CanHealthEntry" }
			},
			"required": ["chassis", "vehicle", "body"],
			"additionalProperties": false
		},
		"FeatureFlagsFull": {
			"type": "object",
			"properties": {
				"fsd": { "$ref": "#/$defs/Bool01" },
				"fsdForce": { "$ref": "#/$defs/Bool01" },
				"profile": { "$ref": "#/$defs/Bool01" },
				"nag": { "$ref": "#/$defs/Bool01" },
				"offset": { "$ref": "#/$defs/Bool01" },
				"isaSpeedChime": { "$ref": "#/$defs/Bool01" },
				"summon": { "$ref": "#/$defs/Bool01" },
				"eap": { "$ref": "#/$defs/Bool01" },
				"evd": { "$ref": "#/$defs/Bool01" },
				"tlssc": { "$ref": "#/$defs/Bool01" }
			},
			"required": [
				"fsd",
				"fsdForce",
				"profile",
				"nag",
				"offset",
				"isaSpeedChime",
				"summon",
				"eap",
				"evd",
				"tlssc"
			],
			"additionalProperties": false
		},
		"FeatureFlagsCompact": {
			"type": "object",
			"properties": {
				"fsd": { "$ref": "#/$defs/Bool01" },
				"fsdForce": { "$ref": "#/$defs/Bool01" },
				"profile": { "$ref": "#/$defs/Bool01" },
				"nag": { "$ref": "#/$defs/Bool01" },
				"offset": { "$ref": "#/$defs/Bool01" },
				"isaSpeedChime": { "$ref": "#/$defs/Bool01" },
				"summon": { "$ref": "#/$defs/Bool01" }
			},
			"required": ["fsd", "fsdForce", "profile", "nag", "offset", "isaSpeedChime", "summon"],
			"additionalProperties": false
		},
		"BootMeta": {
			"type": "object",
			"properties": {
				"hw": { "type": "string", "minLength": 1 },
				"can": { "type": "string", "minLength": 1 },
				"drv": { "type": "string", "minLength": 1 },
				"variant": { "type": "string", "minLength": 1 },
				"cap": { "type": "string", "minLength": 1 },
				"ready": { "const": "runtime-ready" }
			},
			"required": ["hw", "can", "drv", "variant", "cap", "ready"],
			"additionalProperties": false
		},
		"StatusMetaSection": {
			"type": "object",
			"properties": {
				"hw": { "type": "string", "minLength": 1 },
				"can": { "type": "string", "minLength": 1 },
				"drv": { "type": "string", "minLength": 1 },
				"variant": { "type": "string", "minLength": 1 },
				"cap": { "type": "string", "minLength": 1 },
				"ready": { "const": "runtime-ready" },
				"up": { "type": "integer", "minimum": 0 }
			},
			"required": ["hw", "can", "drv", "variant", "cap", "ready", "up"],
			"additionalProperties": false
		},
		"CompactMeta": {
			"type": "object",
			"properties": {
				"hw": { "type": "string", "minLength": 1 },
				"variant": { "type": "string", "minLength": 1 },
				"ready": { "const": "runtime-ready" },
				"up": { "type": "integer", "minimum": 0 }
			},
			"required": ["hw", "variant", "ready", "up"],
			"additionalProperties": false
		},
		"ConnectivityBus": {
			"type": "object",
			"properties": {
				"chassis": { "$ref": "#/$defs/Bool01" },
				"vehicle": { "$ref": "#/$defs/Bool01" },
				"body": { "$ref": "#/$defs/Bool01" }
			},
			"required": ["chassis", "vehicle", "body"],
			"additionalProperties": false
		},
		"BootConnectivity": {
			"type": "object",
			"properties": {
				"bleEnabled": { "$ref": "#/$defs/Bool01" },
				"wifiEnabled": { "$ref": "#/$defs/Bool01" },
				"bus": { "$ref": "#/$defs/ConnectivityBus" },
				"vehicleOnline": { "$ref": "#/$defs/Bool01" },
				"bodyOnline": { "$ref": "#/$defs/Bool01" },
				"chassisOnline": { "$ref": "#/$defs/Bool01" },
				"standby": { "$ref": "#/$defs/Bool01" },
				"bleName": { "type": "string", "minLength": 1 },
				"wifi": {
					"type": "object",
					"properties": {
						"ssid": { "type": "string", "minLength": 1 },
						"port": { "type": "integer", "minimum": 1 }
					},
					"required": ["ssid", "port"],
					"additionalProperties": false
				}
			},
			"required": [
				"bleEnabled",
				"wifiEnabled",
				"bus",
				"vehicleOnline",
				"bodyOnline",
				"chassisOnline",
				"standby"
			],
			"additionalProperties": false
		},
		"StatusConnectivity": {
			"type": "object",
			"properties": {
				"bleEnabled": { "$ref": "#/$defs/Bool01" },
				"wifiEnabled": { "$ref": "#/$defs/Bool01" },
				"bus": { "$ref": "#/$defs/ConnectivityBus" },
				"vehicleOnline": { "$ref": "#/$defs/Bool01" },
				"bodyOnline": { "$ref": "#/$defs/Bool01" },
				"chassisOnline": { "$ref": "#/$defs/Bool01" },
				"standby": { "$ref": "#/$defs/Bool01" }
			},
			"required": [
				"bleEnabled",
				"wifiEnabled",
				"bus",
				"vehicleOnline",
				"bodyOnline",
				"chassisOnline",
				"standby"
			],
			"additionalProperties": false
		},
		"CompactConnectivity": {
			"type": "object",
			"properties": {
				"bt": { "$ref": "#/$defs/Bool01" },
				"wifi": { "$ref": "#/$defs/Bool01" },
				"chassisOnline": { "$ref": "#/$defs/Bool01" },
				"vehicleOnline": { "$ref": "#/$defs/Bool01" },
				"bodyOnline": { "$ref": "#/$defs/Bool01" },
				"standby": { "$ref": "#/$defs/Bool01" }
			},
			"required": ["bt", "wifi", "chassisOnline", "vehicleOnline", "bodyOnline", "standby"],
			"additionalProperties": false
		},
		"StatusProfile": {
			"type": "object",
			"properties": {
				"value": { "type": "integer" },
				"pinned": { "$ref": "#/$defs/Bool01" }
			},
			"required": ["value", "pinned"],
			"additionalProperties": false
		},
		"StatusOffset": {
			"type": "object",
			"properties": {
				"value": { "type": "integer" },
				"pinned": { "$ref": "#/$defs/Bool01" }
			},
			"required": ["value", "pinned"],
			"additionalProperties": false
		},
		"StreamStatus": {
			"type": "object",
			"properties": {
				"on": { "$ref": "#/$defs/Bool01" },
				"emitted": { "type": "integer", "minimum": 0 }
			},
			"required": ["on", "emitted"],
			"additionalProperties": false
		},
		"BootStatusState": {
			"type": "object",
			"properties": {
				"fsd": { "$ref": "#/$defs/Bool01" },
				"fsdForce": { "$ref": "#/$defs/Bool01" },
				"nag": { "$ref": "#/$defs/Bool01" },
				"isaChime": { "$ref": "#/$defs/Bool01" },
				"summonInject": { "$ref": "#/$defs/Bool01" },
				"nagKiller": { "$ref": "#/$defs/Bool01" },
				"nagKillerMode": { "type": "string", "minLength": 1 },
				"dasHandsOn": { "type": "integer" },
				"profile": { "$ref": "#/$defs/StatusProfile" },
				"offset": { "$ref": "#/$defs/StatusOffset" },
				"precondition": { "$ref": "#/$defs/Bool01" },
				"trackMode": { "$ref": "#/$defs/Bool01" },
				"otaInProgress": { "$ref": "#/$defs/Bool01" },
				"txPaused": { "$ref": "#/$defs/Bool01" },
				"detectedHW": { "type": "integer" },
				"variantAutoDetect": { "$ref": "#/$defs/Bool01" },
				"gtwAutopilotTier": { "type": "integer" },
				"rawCan": { "$ref": "#/$defs/Bool01" },
				"stream": { "$ref": "#/$defs/StreamStatus" }
			},
			"required": [
				"fsd",
				"fsdForce",
				"nag",
				"isaChime",
				"summonInject",
				"nagKiller",
				"nagKillerMode",
				"dasHandsOn",
				"profile",
				"offset",
				"precondition",
				"trackMode",
				"otaInProgress",
				"txPaused",
				"detectedHW",
				"variantAutoDetect",
				"gtwAutopilotTier",
				"rawCan",
				"stream"
			],
			"additionalProperties": false
		},
		"StatusStatePayload": {
			"type": "object",
			"properties": {
				"fsd": { "$ref": "#/$defs/Bool01" },
				"fsdForce": { "$ref": "#/$defs/Bool01" },
				"nag": { "$ref": "#/$defs/Bool01" },
				"nagKiller": { "$ref": "#/$defs/Bool01" },
				"profile": { "$ref": "#/$defs/StatusProfile" },
				"offset": { "$ref": "#/$defs/StatusOffset" },
				"precondition": { "$ref": "#/$defs/Bool01" },
				"trackMode": { "$ref": "#/$defs/Bool01" },
				"otaInProgress": { "$ref": "#/$defs/Bool01" },
