{
	"name": "teslacanmodder",
	"version": "1.3.0",
	"private": true,
	"description": "Tesla CAN bus modifier — firmware, client app, and debug tools",
	"workspaces": [
		"packages/*",
		"client",
		"tools"
	],
	"scripts": {
		"audit:ci": "node scripts/npm-audit-actionable.cjs --severity=moderate",
		"build:protocol": "npm run build -w @teslacanmodder/protocol",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"lint:all": "npm run lint && npm run format:check",
		"lint": "eslint .",
		"prepare": "husky",
		"regen:firmware:compiledb": "cd firmware && .\\pio.ps1 run -e esp32_wifi_ble -t compiledb",
		"smoke:firmware:release-matrix": "node scripts/release-matrix-smoke.mjs",
		"test:all": "npm run validate:serial-contract && npm run build:protocol && npm run test:protocol && npm run test:client && npm run test:tools && npm run test:firmware",
		"test:client": "npm run build:protocol && npm test -w @teslacanmodder/client",
		"test:firmware": "cd firmware && .\\pio.ps1 test -e native",
		"test:protocol": "npm test -w @teslacanmodder/protocol",
		"test:tools": "npm test -w @teslacanmodder/tools",
		"typecheck:client": "tsc -p client/tsconfig.json --noEmit",
		"typecheck:protocol": "tsc -p packages/protocol/tsconfig.json --noEmit",
		"validate:serial-contract": "node scripts/validate-serial-contract.mjs"
	},
	"lint-staged": {
		"*.{ts,tsx,js,cjs,mjs}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"engines": {
		"node": ">=22"
	},
	"overrides": {
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-native": "0.81.5",
		"react-test-renderer": "19.1.0",
		"babel-preset-expo": "~54.0.10",
		"@react-native/babel-plugin-codegen": "~0.81.6",
		"@react-native/babel-preset": "~0.81.6",
		"@react-native/codegen": "~0.81.6",
		"jest": "^29.7.0"
	},
	"license": "GPL-3.0",
	"devDependencies": {
		"@babel/runtime": "^7.29.2",
		"@eslint/js": "^9.28.0",
		"ajv": "^8.20.0",
		"eslint": "^10.5.0",
		"globals": "^16.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.5.3",
		"typescript-eslint": "^8.59.3"
	},
	"dependencies": {
		"@react-native/jest-preset": "^0.85.3",
		"react-native-worklets": "^0.5.2"
	}
}
