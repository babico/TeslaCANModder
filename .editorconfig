root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{js,jsx,ts,tsx,json,css,html,yml,yaml,md}]
indent_style = tab
indent_size = 4

[*.py]
indent_style = tab
indent_size = 4

[*.{cpp,h,c,ino}]
indent_style = tab
indent_size = 4

[platformio.ini]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
