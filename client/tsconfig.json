{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"moduleResolution": "Bundler",
		"module": "ESNext",
		"moduleDetection": "force",
		"useUnknownInCatchVariables": true,
		"jsx": "react-jsx",
		"types": ["react", "react-native", "jest", "w3c-web-serial"]
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "nativewind-env.d.ts"],
	"exclude": ["node_modules"]
}
