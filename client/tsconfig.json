{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "moduleDetection": "force",
    "useUnknownInCatchVariables": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "types": ["react", "react-native", "jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "exclude": ["node_modules"]
}
